{
  "name": "forumaker/magicdice",
  "description": "Adds animated dice rolls with unique skins",
  "type": "flarum-extension",
  "keywords": ["flarum", "flarum-extension", "dice", "random", "magic"],
  "license": "MIT",
  "homepage": "https://github.com/forumaker/magicdice",
  "support": {
    "issues": "https://github.com/forumaker/magicdice/issues",
    "source": "https://github.com/forumaker/magicdice",
    "forum": "https://discuss.flarum.org/d/38444-magicdice-animated-dice-rolls"
  },
  "authors": [
    {
      "name": "forumaker",
      "role": "Developer",
      "email": "arsenyuxw@gmail.com",
      "homepage": "https://github.com/forumaker"
    }
  ],
  "require": {
    "php": "^8.3",
    "flarum/core": "^2.0"
  },
  "require-dev": {
    "flarum/testing": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "forumaker\\MagicDice\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "forumaker\\MagicDice\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "phpunit -c tests/phpunit.unit.xml",
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php"
  },
  "extra": {
    "branch-alias": {
      "dev-2.x": "2.x-dev"
    },
    "flarum-extension": {
      "title": "Magic Dice",
      "category": "feature",
      "icon": {
        "name": "fas fa-dice-d20",
        "backgroundColor": "#6A5ACD",
        "color": "#ffffff"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}